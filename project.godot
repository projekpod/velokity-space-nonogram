config_version=5

[application]

config/name="Velokity: Space Nonogram"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Events="*res://scripts/autoload/events.gd"
Save="*res://scripts/autoload/save.gd"
Settings="*res://scripts/autoload/settings.gd"
Audio="*res://scripts/autoload/audio.gd"
Economy="*res://scripts/autoload/economy.gd"
Ads="*res://scripts/autoload/ads.gd"
Analytics="*res://scripts/autoload/analytics.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=432
window/size/window_height_override=768
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[internationalization]

locale/fallback="en"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
